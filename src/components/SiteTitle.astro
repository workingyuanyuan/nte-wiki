---
// Override of Starlight's SiteTitle: the site name, a mark that the site is not the
// publisher's, and a link to the first page of each top-level sidebar group (versions,
// characters, systems and names), in the sidebar's order and labels. The Markdown twin,
// llms.txt and index.json are linked from the page notes (MarkdownContent.astro).
import { LABELS, localeOf } from '../lib/site.mjs';

const { siteTitle, siteTitleHref, entry, sidebar } = Astro.locals.starlightRoute;
const t = LABELS[localeOf(entry.id).lang];
const links = (entries) => entries.flatMap((e) => (e.type === 'link' ? [e] : links(e.entries)));
const sections = sidebar
	.filter((e) => e.type === 'group')
	.map((group) => {
		const inner = links(group.entries);
		return { label: group.label, href: inner[0]?.href, current: inner.some((e) => e.isCurrent) };
	})
	.filter((s) => s.href);
---

<a href={siteTitleHref} class="site-title" translate="no">
	<span class="name">{siteTitle}</span>
	<span class="unofficial">{t.unofficial}</span>
</a>
<nav class="sections" aria-label={t.sections}>
	{sections.map((s) => <a href={s.href} aria-current={s.current ? 'true' : undefined}>{s.label}</a>)}
</nav>

<style>
	.site-title {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		font-family: var(--nte-pixel);
		font-size: 24px;
		font-weight: 400;
		line-height: 1;
		color: var(--sl-color-white);
		text-decoration: none;
		white-space: nowrap;
	}
	.name::after {
		content: '';
		display: inline-block;
		width: 12px;
		height: 3px;
		margin-inline-start: 3px;
		background: var(--nte-cyan);
	}
	.unofficial {
		padding: 0 6px;
		border: 1px solid var(--nte-pink);
		color: var(--nte-pink-text);
		font-size: 12px;
		line-height: 18px;
	}
	.sections {
		display: none;
		gap: 18px;
		margin-inline-start: 24px;
		font-family: var(--nte-pixel);
		font-size: 12px;
		white-space: nowrap;
	}
	@media (min-width: 72rem) {
		.sections {
			display: flex;
		}
	}
	.sections a {
		padding: 0 3px;
		color: var(--sl-color-gray-3);
		text-decoration: none;
		text-transform: uppercase;
	}
	/* The section of the current page: full text colour and a cyan rule under it. */
	.sections a[aria-current] {
		color: var(--sl-color-white);
		box-shadow: inset 0 -3px 0 var(--nte-cyan);
	}
	.sections a:hover,
	.sections a:focus-visible {
		background: var(--nte-cyan);
		color: var(--nte-ink);
	}
	@keyframes blink {
		50% { opacity: 0; }
	}
	@media (prefers-reduced-motion: no-preference) {
		.name::after {
			animation: blink 1s steps(1) infinite;
		}
	}
</style>
