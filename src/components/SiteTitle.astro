---
// Override of Starlight's SiteTitle: the site name, a mark that the site is not the
// publisher's, and links to the machine-readable outputs of the current page. The
// bracketed key hints before the links are drawn by CSS (`[data-key]::before`), so they
// never reach the text an agent extracts from the page.
import { LABELS, pageId, localeOf, mdPath, llmsPath, withBase } from '../lib/site.mjs';

const { siteTitle, siteTitleHref, entry } = Astro.locals.starlightRoute;
const locale = localeOf(entry.id);
const t = LABELS[locale.lang];
const links = [
	...(entry.data.lastVerified ? [{ key: 'M', label: 'Markdown', href: withBase(mdPath(pageId(entry.id))) }] : []),
	{ key: 'L', label: 'llms.txt', href: withBase(llmsPath(locale)) },
	{ key: 'J', label: 'index.json', href: withBase('/index.json') },
];
---

<a href={siteTitleHref} class="site-title" translate="no">
	<span class="name">{siteTitle}</span>
	<span class="unofficial">{t.unofficial}</span>
</a>
<nav class="outputs" aria-label={locale.lang === 'zh-TW' ? '本頁的其他格式' : 'Other formats of this page'}>
	{links.map((link) => <a href={link.href} data-key={link.key} aria-keyshortcuts={link.key.toLowerCase()}>{link.label}</a>)}
</nav>

<script is:inline>
	// Single-key shortcuts for the links above. Ignored while typing or with modifier keys.
	document.addEventListener('keydown', (event) => {
		if (event.defaultPrevented || event.ctrlKey || event.metaKey || event.altKey) return;
		const target = event.target;
		if (target instanceof HTMLElement) {
			if (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName)) return;
		}
		if (document.querySelector('dialog[open]')) return;
		const link = document.querySelector(`nav.outputs a[data-key="${event.key.toUpperCase()}"]`);
		if (link instanceof HTMLAnchorElement) link.click();
	});
</script>

<style>
	.site-title {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		font-family: var(--nte-pixel);
		font-size: 24px;
		font-weight: 400;
		line-height: 1;
		color: var(--sl-color-white);
		text-decoration: none;
		white-space: nowrap;
	}
	.name::after {
		content: '';
		display: inline-block;
		width: 12px;
		height: 3px;
		margin-inline-start: 3px;
		background: var(--nte-cyan);
	}
	.unofficial {
		padding: 0 6px;
		border: 1px solid var(--nte-pink);
		color: var(--nte-pink-text);
		font-size: 12px;
		line-height: 18px;
	}
	.outputs {
		display: none;
		gap: 18px;
		margin-inline-start: 24px;
		font-family: var(--nte-pixel);
		font-size: 12px;
		white-space: nowrap;
	}
	@media (min-width: 72rem) {
		.outputs {
			display: flex;
		}
	}
	.outputs a {
		padding: 0 3px;
		color: var(--sl-color-gray-3);
		text-decoration: none;
		text-transform: uppercase;
	}
	.outputs a::before {
		content: '[' attr(data-key) '] ';
		color: var(--nte-pink-text);
	}
	.outputs a:hover::before,
	.outputs a:focus-visible::before {
		color: var(--nte-ink);
	}
	.outputs a:hover,
	.outputs a:focus-visible {
		background: var(--nte-cyan);
		color: var(--nte-ink);
	}
	@keyframes blink {
		50% { opacity: 0; }
	}
	@media (prefers-reduced-motion: no-preference) {
		.name::after {
			animation: blink 1s steps(1) infinite;
		}
	}
</style>
